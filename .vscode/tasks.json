{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (Dev)",
      "type": "shell",
      "command": "go run cmd/main.go",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Frontend (Dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Frontend Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start All",
      "dependsOn": ["Start Backend (Dev)", "Start Frontend (Dev)"],
      "problemMatcher": []
    },
    {
      "label": "Build Backend (Linux)",
      "type": "shell",
      "command": "mkdir -p ../dist-bin && GOOS=linux GOARCH=amd64 go build -o ../dist-bin/foto-facil-backend-linux cmd/main.go",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build Backend (Windows)",
      "type": "shell",
      "command": "mkdir -p ../dist-bin && GOOS=windows GOARCH=amd64 go build -o ../dist-bin/foto-facil-backend-windows.exe cmd/main.go",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build Frontend (Vite/Electron)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build All (Linux)",
      "dependsOn": ["Build Backend (Linux)", "Build Frontend (Vite/Electron)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build All (Windows)",
      "dependsOn": ["Build Backend (Windows)", "Build Frontend (Vite/Electron)"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
